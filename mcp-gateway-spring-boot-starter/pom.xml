<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ashishgituser</groupId>
    <artifactId>springboot-mcp-gateway</artifactId>
    <version>0.1.1</version>
  </parent>

  <artifactId>mcp-gateway-spring-boot-starter</artifactId>
  <packaging>jar</packaging>

  <name>MCP Gateway :: Spring Boot Starter</name>
  <description>
    Starter POM for the MCP gateway. Add this single dependency to a Spring Boot application to
    pull in auto-configuration, sensible default beans and their required transitive dependencies.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.ashishgituser</groupId>
      <artifactId>mcp-gateway-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Optional: brings OAuth2/API-key authentication for the gateway's MCP endpoint. Not required
      to use the gateway — omit it and every caller resolves to GatewayPrincipal.ANONYMOUS, so
      policy rules can only key on tool name. Add it (and its own mcp.security.* configuration,
      see https://github.com/spring-ai-community/mcp-security) to authenticate callers, which also
      unlocks role-based policy rules via mcp.gateway.policy.rules[].roles.
    -->
    <dependency>
      <groupId>org.springaicommunity</groupId>
      <artifactId>mcp-server-security-spring-boot</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Optional: exposes /actuator/health (with a per-upstream "upstreams" indicator that pings
      each MCP session) and /actuator/metrics (tool call counts/latency via Micrometer). Without
      it the gateway still records the same data through the ObservationRegistry API, it's just
      not exported anywhere.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
