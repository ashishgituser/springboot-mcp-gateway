<?xml version="1.0" encoding="UTF-8"?>
<!--
  Not part of the main reactor: this deliberately builds against a different Spring Boot version
  than the rest of the project, to prove the published starter still runs on Boot 3.x.

    mvn -B install -DskipTests            # publish the starter to the local repo
    mvn -B -f compat/boot3/pom.xml compile exec:java
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>io.github.ashishgituser</groupId>
  <artifactId>mcp-gateway-boot3-compat</artifactId>
  <version>0.2.0</version>
  <name>MCP Gateway :: Spring Boot 3 compatibility check</name>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.ashishgituser</groupId>
      <artifactId>mcp-gateway-spring-boot-starter</artifactId>
      <version>0.2.0</version>
      <exclusions>
        <!-- The SDK ships a Jackson 3 binding by default; Boot 3 is on Jackson 2. -->
        <exclusion>
          <groupId>io.modelcontextprotocol.sdk</groupId>
          <artifactId>mcp-json-jackson3</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <mainClass>io.github.ashishgituser.mcpgateway.compat.Boot3CompatibilityCheck</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
